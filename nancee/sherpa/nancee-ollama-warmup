#!/usr/bin/env python3
from __future__ import annotations

import json
import os
import sys
import time
import urllib.error
import urllib.request

from config import (
    LLM_NUM_THREADS,
    OLLAMA_WARMUP_TIMEOUT,
    SYSTEM_PROMPT_FILE,
    load_system_prompt,
)
from prompt_identity import (
    log_prompt_identity,
    text_sha256,
)
from warmup_contract import (
    CONTEXT_PRIME_EXPECTED_REPLY,
    CONTEXT_PRIME_NUM_PREDICT,
    CONTEXT_PRIME_TEMPERATURE,
    WARMUP_STATE_FILE,
    build_startup_warmup_messages,
    build_warmup_fingerprint,
)

OLLAMA_CHAT_URL = os.environ.get(
    "OLLAMA_CHAT_URL",
    "http://127.0.0.1:11434/api/chat",
).strip()

KEEP_ALIVE_VALUE = os.environ.get(
    "OLLAMA_KEEP_ALIVE",
    "-1",
).strip()

# nancee_chat.py permits the helper to run for
# OLLAMA_WARMUP_TIMEOUT seconds. Stop slightly earlier
# so this helper can report its own useful error.
TOTAL_TIMEOUT_SECONDS = max(
    30,
    OLLAMA_WARMUP_TIMEOUT - 10,
)


def fail(message: str) -> None:
    print(
        f"[FAILED] {message}",
        flush=True,
    )
    raise SystemExit(1)


def parse_keep_alive():
    try:
        return int(KEEP_ALIVE_VALUE)

    except ValueError:
        return KEEP_ALIVE_VALUE


def remaining_time(deadline: float) -> float:
    remaining = deadline - time.monotonic()

    if remaining <= 0:
        fail(f"Warmup exceeded the {TOTAL_TIMEOUT_SECONDS}-second limit")

    return remaining


def duration_seconds(
    data: dict,
    field: str,
) -> float:
    return data.get(field, 0) / 1_000_000_000


def write_warmup_state(
    fingerprint: dict[str, object],
) -> None:
    state = {
        **fingerprint,
        "verified_at_epoch": time.time(),
    }

    WARMUP_STATE_FILE.parent.mkdir(
        parents=True,
        exist_ok=True,
    )

    temporary_file = WARMUP_STATE_FILE.with_name(WARMUP_STATE_FILE.name + ".tmp")

    temporary_file.write_text(
        json.dumps(
            state,
            indent=2,
            sort_keys=True,
        )
        + "\n",
        encoding="utf-8",
    )

    os.replace(
        temporary_file,
        WARMUP_STATE_FILE,
    )

    print(
        f"[WARMUP STATE] written={WARMUP_STATE_FILE}",
        flush=True,
    )


def run_warmup_request(
    model: str,
    system_prompt: str,
    deadline: float,
    pass_name: str,
) -> tuple[str, float]:
    messages = build_startup_warmup_messages(
        system_prompt,
    )

    log_prompt_identity(
        f"warmup-{pass_name.lower()}",
        prefix_messages=messages[:-1],
        full_messages=messages,
    )

    payload = {
        "model": model,
        "stream": True,
        "keep_alive": parse_keep_alive(),
        "messages": messages,
        "options": {
            "temperature": CONTEXT_PRIME_TEMPERATURE,
            "num_thread": LLM_NUM_THREADS,
            "num_predict": CONTEXT_PRIME_NUM_PREDICT,
        },
    }

    request = urllib.request.Request(
        OLLAMA_CHAT_URL,
        data=json.dumps(payload).encode("utf-8"),
        headers={
            "Content-Type": "application/json",
        },
        method="POST",
    )

    started = time.monotonic()
    reply_parts: list[str] = []
    final_data = None

    print(
        f"[{pass_name}] Sending streamed Nancee prompt...",
        flush=True,
    )

    try:
        with urllib.request.urlopen(
            request,
            timeout=remaining_time(deadline),
        ) as response:
            for raw_line in response:
                line = raw_line.decode(
                    "utf-8",
                    errors="replace",
                ).strip()

                if not line:
                    continue

                data = json.loads(line)

                if data.get("error"):
                    fail(f"{pass_name} returned an error: {data['error']}")

                token = data.get("message", {}).get("content", "")

                if token:
                    reply_parts.append(token)

                if data.get("done"):
                    final_data = data
                    break

    except urllib.error.HTTPError as error:
        details = error.read().decode(
            "utf-8",
            errors="replace",
        )

        fail(f"{pass_name} returned HTTP {error.code}: {details}")

    except urllib.error.URLError as error:
        fail(f"{pass_name} could not reach Ollama: {error}")

    except TimeoutError:
        fail(f"{pass_name} exceeded the {TOTAL_TIMEOUT_SECONDS}-second limit")

    except json.JSONDecodeError as error:
        fail(f"{pass_name} returned invalid JSON: {error}")

    if final_data is None:
        fail(f"{pass_name} did not return a completed response")

    reply = "".join(reply_parts).strip()

    if not reply:
        fail(f"{pass_name} returned an empty response")

    if reply != CONTEXT_PRIME_EXPECTED_REPLY:
        fail(
            f"{pass_name} returned {reply!r}; "
            f"expected {CONTEXT_PRIME_EXPECTED_REPLY!r}"
        )

    elapsed = time.monotonic() - started

    print(
        f"[{pass_name}] Response: {reply}",
        flush=True,
    )
    print(
        f"[{pass_name}] Elapsed: {elapsed:.3f}s",
        flush=True,
    )
    print(
        f"[{pass_name}] Model load: "
        f"{duration_seconds(final_data, 'load_duration'):.3f}s",
        flush=True,
    )
    print(
        f"[{pass_name}] Prompt evaluation: "
        f"{duration_seconds(final_data, 'prompt_eval_duration'):.3f}s",
        flush=True,
    )
    print(
        f"[{pass_name}] Generation: "
        f"{duration_seconds(final_data, 'eval_duration'):.3f}s",
        flush=True,
    )
    print(
        f"[{pass_name}] Prompt tokens: {final_data.get('prompt_eval_count', 0)}",
        flush=True,
    )

    return reply, elapsed


def main() -> None:
    if len(sys.argv) != 2:
        fail("Usage: nancee-ollama-warmup MODEL_NAME")

    model = sys.argv[1].strip()

    if not model:
        fail("Model name cannot be empty")

    system_prompt = load_system_prompt()
    prompt_hash = text_sha256(
        system_prompt,
    )

    print(
        f"[STARTING] Model: {model}",
        flush=True,
    )
    print(
        f"[STARTING] System prompt: {SYSTEM_PROMPT_FILE}",
        flush=True,
    )
    print(
        f"[STARTING] Prompt SHA256: {prompt_hash}",
        flush=True,
    )
    print(
        "[STARTING] LLM options: "
        f"temperature={CONTEXT_PRIME_TEMPERATURE} "
        f"threads={LLM_NUM_THREADS} "
        f"num_predict={CONTEXT_PRIME_NUM_PREDICT}",
        flush=True,
    )
    print(
        "[STARTING] Timeouts: "
        f"helper={TOTAL_TIMEOUT_SECONDS}s "
        f"caller={OLLAMA_WARMUP_TIMEOUT}s",
        flush=True,
    )

    deadline = time.monotonic() + TOTAL_TIMEOUT_SECONDS

    # First pass loads the model and evaluates the prompt.
    run_warmup_request(
        model=model,
        system_prompt=system_prompt,
        deadline=deadline,
        pass_name="WARMUP",
    )

    # Second identical pass verifies the hot path.
    _, verification_elapsed = run_warmup_request(
        model=model,
        system_prompt=system_prompt,
        deadline=deadline,
        pass_name="VERIFY",
    )

    # Write state only after both passes succeed.
    fingerprint = build_warmup_fingerprint(
        model,
        system_prompt,
    )

    write_warmup_state(
        fingerprint,
    )

    print(
        f"[READY] Model: {model}",
        flush=True,
    )
    print(
        f"[READY] Verification response time: {verification_elapsed:.3f}s",
        flush=True,
    )
    print(
        "[READY] STATUS=MODEL_RESPONDED",
        flush=True,
    )


if __name__ == "__main__":
    main()
